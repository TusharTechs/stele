# ---------------------------------------------------------------- Livepeer Agent
# The media network. Everything the studio generates, edits, judges and narrates runs here.
LIVEPEER_MCP_URL=https://agent.livepeer.org/api/mcp
# Optional. Without a key you run on keyless demo credits, which are capped per network
# address. Get one from https://agent.livepeer.org/get-started.html
LIVEPEER_API_KEY=

# ---------------------------------------------------------------- Knowledge store
#   file    — in-process oxigraph. Real SPARQL, no DKG node. Explore with nothing installed.
#             NOT evidence of a DKG integration, and the app says so wherever it appears.
#   edge    — a real DKG node. Working + Shared Working Memory, gossiped to peers. No chain.
#   network — the same node, plus sealing a production to Verifiable Memory for a UAL.
STELE_DKG=file

DKG_CONTEXT_GRAPH_NAME=stele-studio
# Set this to pin an exact id and skip resolution. The node prefixes a bare name with your
# agent address, e.g. 0xabc…/stele-studio
DKG_CONTEXT_GRAPH_ID=
DKG_NETWORK=testnet
DKG_CLI_BIN=dkg
DKG_API_URL=http://127.0.0.1:9200
# Read from ~/.dkg/auth.token when unset. Never commit this.
DKG_API_TOKEN=

# ---------------------------------------------------------------- Limits
# Ceiling for one attempt. A stage that would cross it stops the run rather than spending through.
STELE_RUN_BUDGET_USD=8
STELE_DATA_DIR=.data
